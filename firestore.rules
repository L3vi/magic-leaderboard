rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Players collection: public read, authenticated write
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sessions and nested games: public read, authenticated write
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Cube events: public read, authenticated write
    match /cube-events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
